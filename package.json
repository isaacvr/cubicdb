{
  "name": "cubicdb",
  "productName": "CubicDB",
  "version": "2.1.3",
  "description": "Cubing with fun",
  "homepage": "https://github.com/isaacvr/cubicdb",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaacvr/cubicdb.git"
  },
  "private": true,
  "type": "module",
  "author": {
    "name": "Isaac Vega Rodriguez",
    "email": "isaacvega1996@gmail.com"
  },
  "keywords": [
    "cubicdb",
    "speed",
    "timer",
    "simulator",
    "cca",
    "sport",
    "cube",
    "rubik",
    "speedsolving",
    "speedcubing",
    "wca",
    "svelte",
    "electron",
    "nodejs",
    "typescript",
    "desktop",
    "windows"
  ],
  "main": "src/electron/index.cjs",
  "scripts": {
    "dev": "concurrently \"npm run web\" \"electron-forge start -- --serve\"",
    "build": "vite build",
    "web": "vite dev",
    "preview": "vite preview",
    "builder": "electron-builder build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --check . && eslint . --fix",
    "lint:oxc": "npx oxlint -c .oxlintrc.json",
    "format": "prettier --write .",
    "test": "npm run test:integration && npm run test:unit",
    "test:integration": "playwright test",
    "test:unit": "vitest"
  },
  "license": "MIT",
  "overrides": {
    "electron-rebuild": {
      "node-abi": "3.68.0"
    }
  },
  "config": {
    "forge": {
      "electronRebuildConfig": {
        "forceABI": 113
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "platforms": [
            "win32"
          ],
          "config": {
            "outputDirectory": "./release",
            "noMsi": true
          }
        }
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "7.4.2",
    "@capacitor/core": "7.4.2",
    "@capacitor/ios": "7.4.2",
    "@electron/remote": "2.1.3",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "^4.1.18",
    "@xstate/svelte": "5.0.0",
    "ably": "2.10.0",
    "archiver": "7.0.1",
    "async-lz-string": "1.1.0",
    "axios": "1.13.2",
    "cors": "2.8.5",
    "cubicdb-module": "1.0.6",
    "electron-reload": "2.0.0-alpha.1",
    "electron-updater": "6.6.2",
    "eruda": "3.4.3",
    "express": "5.1.0",
    "fft.js": "4.0.4",
    "flowbite-svelte-icons": "2.2.1",
    "idb": "8.0.3",
    "js-confetti": "0.12.0",
    "jspdf": "3.0.1",
    "jszip": "3.10.1",
    "katex": "0.16.22",
    "lucide-svelte": "0.537.0",
    "moment": "2.30.1",
    "nedb": "1.8.0",
    "node-machine-id": "1.1.12",
    "object-hash": "3.0.0",
    "qrcode": "1.5.4",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "svelte-easy-crop": "4.0.1",
    "svelte-routing": "2.13.0",
    "tailwind-merge": "3.3.1",
    "three": "0.177.0",
    "unzipper": "0.12.3",
    "xstate": "5.20.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.2",
    "@electron-forge/cli": "7.10.2",
    "@electron-forge/maker-deb": "7.10.2",
    "@electron-forge/maker-rpm": "7.10.2",
    "@electron-forge/maker-squirrel": "7.10.2",
    "@electron-forge/maker-zip": "7.10.2",
    "@playwright/test": "1.54.1",
    "@sveltejs/adapter-auto": "7.0.0",
    "@sveltejs/adapter-netlify": "5.0.2",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.49.2",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tsconfig/svelte": "5.0.4",
    "@types/archiver": "6.0.3",
    "@types/audioworklet": "0.0.77",
    "@types/echarts": "5.0.0",
    "@types/eslint": "9.6.1",
    "@types/katex": "0.16.7",
    "@types/nedb": "1.8.16",
    "@types/object-hash": "3.0.6",
    "@types/qrcode": "1.5.5",
    "@types/three": "0.177.0",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-basic-ssl": "2.1.0",
    "autoprefixer": "10.4.21",
    "concurrently": "9.1.2",
    "daisyui": "5.5.19",
    "echarts": "5.6.0",
    "electron": "39.2.4",
    "electron-builder": "26.0.12",
    "esbuild": "0.27.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-svelte": "3.13.0",
    "globals": "16.5.0",
    "node-abi": "4.9.0",
    "postcss": "8.5.6",
    "postcss-load-config": "6.0.1",
    "prettier": "3.7.4",
    "prettier-plugin-svelte": "3.4.1",
    "sass": "1.95.1",
    "svelte": "5.46.1",
    "svelte-check": "4.3.5",
    "svelte-flag-icons": "2.0.1",
    "svelte-preprocess": "6.0.3",
    "tailwindcss": "4.1.18",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.3.0",
    "vite-plugin-pwa": "1.0.1",
    "vitest": "4.0.15"
  }
}
